<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B1D">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#0D1638">

        <TextView
            android:id="@+id/editorBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/editorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="My Project"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editorSave"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="SAVE"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_selected" />

    </LinearLayout>

    <!-- VIDEO PREVIEW -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"
        android:background="#000000">

        <VideoView
            android:id="@+id/videoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <TextView
            android:id="@+id/videoTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="00:00 / 00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </FrameLayout>

    <!-- PLAYBACK CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:background="#0D1638">

        <TextView
            android:id="@+id/undoButton"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="↶"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/playButton"
            android:layout_width="55dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/redoButton"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="↷"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- REAL TIMELINE -->
    <HorizontalScrollView
        android:id="@+id/timelineScroll"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:scrollbars="horizontal"
        android:background="#0A1029">

        <com.myvideoeditor.editor.TimelineView
            android:id="@+id/timelineView"
            android:layout_width="wrap_content"
            android:layout_height="210dp" />

    </HorizontalScrollView>

    <!-- TOOL BAR -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:scrollbars="none"
        android:background="#0D1638">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="✂&#10;Trim"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="✂&#10;Split"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="📝&#10;Text"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="🎵&#10;Audio"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="🖼️&#10;Media"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="✨&#10;Effects"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="🎨&#10;Filter"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="⚙&#10;More"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
