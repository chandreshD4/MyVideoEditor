<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070910">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0F121E"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/editorBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/editorProjectName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="New Project"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/editorUndo"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="↶"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/editorRedo"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="↷"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/editorExport"
            android:layout_width="90dp"
            android:layout_height="38dp"
            android:text="EXPORT"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#4650DC" />

    </LinearLayout>

    <!-- MAIN EDITING AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#0A0C14">

        <!-- LEFT TOOLBAR -->
        <LinearLayout
            android:id="@+id/leftToolbar"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#0D101B">

            <TextView
                android:id="@+id/toolMedia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Media"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolLayer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Layer"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Text"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolAudio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Audio"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolVoice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Voice"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

        </LinearLayout>

        <!-- PREVIEW -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#000000"
            android:foregroundGravity="center">

            <FrameLayout
                android:id="@+id/previewHolder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- RIGHT TOOLBAR -->
        <LinearLayout
            android:id="@+id/rightToolbar"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:background="#0D101B">

            <TextView
                android:id="@+id/toolCrop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Crop"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolSpeed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Speed"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolFilter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Filter"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolEffect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Effect"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

            <TextView
                android:id="@+id/toolMore"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="More"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:background="#181C2B" />

        </LinearLayout>

    </LinearLayout>

    <!-- TIMELINE -->
    <FrameLayout
        android:id="@+id/timelineArea"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0C0F19">

        <!-- TIMELINE HEADER -->
        <LinearLayout
            android:id="@+id/timelineHeader"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#121623">

            <TextView
                android:id="@+id/timelineZoomOut"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/timelineZoomValue"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/timelineZoomIn"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- SCROLLING TIMELINE -->
        <HorizontalScrollView
            android:id="@+id/timelineScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/timelineContent"
                android:layout_width="1800dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="180dp"
                android:paddingEnd="180dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- VIDEO TRACK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:text="VIDEO"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:background="#191D2A" />

                    <TextView
                        android:id="@+id/videoTimelineClip"
                        android:layout_width="520dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:text="  Video Clip  "
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:gravity="center_vertical"
                        android:background="#2D4B7D" />

                </LinearLayout>

                <!-- TEXT TRACK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:text="TEXT"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:background="#191D2A" />

                    <TextView
                        android:id="@+id/textTimelineClip"
                        android:layout_width="520dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:text="  Text Track  "
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:gravity="center_vertical"
                        android:background="#503769" />

                </LinearLayout>

                <!-- AUDIO TRACK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:text="AUDIO"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:background="#191D2A" />

                    <TextView
                        android:id="@+id/audioTimelineClip"
                        android:layout_width="520dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:text="  Audio Track  "
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:gravity="center_vertical"
                        android:background="#2D694B" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- FIXED CENTER PLAYHEAD -->
        <View
            android:id="@+id/fixedPlayhead"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:background="#FF3030" />

    </FrameLayout>

</LinearLayout>
