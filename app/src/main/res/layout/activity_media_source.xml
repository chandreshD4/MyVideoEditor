<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/mediaBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:text="Choose Media"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mediaClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Choose your media source"
            android:textColor="#9EA6B5"
            android:textSize="14sp" />

        <!-- SIX MAIN BOXES -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- 1 MEDIA -->

            <TextView
                android:id="@+id/importButton"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#182D3F"
                android:gravity="center"
                android:text="▣&#10;MEDIA&#10;Photo &amp; Video"
                android:textColor="#5DD7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 2 COLORS -->

            <TextView
                android:id="@+id/colorsBox"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#3A2E17"
                android:gravity="center"
                android:text="●&#10;COLORS&#10;Background"
                android:textColor="#FFD75A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 3 DEVICE -->

            <TextView
                android:id="@+id/mediaDevice"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#29203D"
                android:gravity="center"
                android:text="▤&#10;DEVICE&#10;Files"
                android:textColor="#C9A8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 4 PHOTOS -->

            <TextView
                android:id="@+id/mediaPhotos"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#203A2D"
                android:gravity="center"
                android:text="▧&#10;PHOTOS&#10;Gallery"
                android:textColor="#72E6A7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 5 AUDIO -->

            <TextView
                android:id="@+id/boxFive"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#3A202C"
                android:gravity="center"
                android:text="♫&#10;AUDIO&#10;Music"
                android:textColor="#FF91B0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 6 MORE -->

            <TextView
                android:id="@+id/boxSix"
                android:layout_width="0dp"
                android:layout_height="116dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#20343A"
                android:gravity="center"
                android:text="＋&#10;MORE&#10;Sources"
                android:textColor="#70DDE8"
                android:textSize="14sp"
                android:textStyle="bold" />

        </GridLayout>

        <!-- AUTOMATIC MEDIA AREA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:text="Your Media"
            android:textColor="#F1F3F8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mediaEmptyText"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:background="#11161F"
            android:gravity="center"
            android:text="Loading photos and videos..."
            android:textColor="#8F98A8"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mediaFoldersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- CURRENTLY SELECTED MEDIA -->

        <TextView
            android:id="@+id/importedMedia"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#11161F"
            android:gravity="center"
            android:text="No media selected"
            android:textColor="#55D8FF"
            android:textSize="13sp" />

        <!-- SELECTED COLOR STATUS -->

        <TextView
            android:id="@+id/backgroundSelected"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="Selected: Black" />

        <!-- CONTINUE -->

        <TextView
            android:id="@+id/backgroundDone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_create_button"
            android:gravity="center"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
