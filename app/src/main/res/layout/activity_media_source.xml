<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/mediaBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:text="Choose Media"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mediaClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select media, background or another source"
            android:textColor="#9EA6B5"
            android:textSize="14sp" />

        <!-- SIX MAIN BOXES -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- BOX 1 : MEDIA -->

            <TextView
                android:id="@+id/importButton"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#18283A"
                android:gravity="center"
                android:text="▣&#10;MEDIA&#10;Photo &amp; Video"
                android:textColor="#5DD7FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- BOX 2 : COLORS -->

            <TextView
                android:id="@+id/colorsBox"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#302719"
                android:gravity="center"
                android:text="●&#10;COLORS&#10;Background"
                android:textColor="#FFD75A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- BOX 3 -->

            <TextView
                android:id="@+id/mediaDevice"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#211C35"
                android:gravity="center"
                android:text="▤&#10;DEVICE&#10;Files"
                android:textColor="#C7A8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- BOX 4 -->

            <TextView
                android:id="@+id/mediaPhotos"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#203228"
                android:gravity="center"
                android:text="▧&#10;PHOTOS&#10;Gallery"
                android:textColor="#72E6A7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- BOX 5 -->

            <TextView
                android:id="@+id/boxFive"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#34202A"
                android:gravity="center"
                android:text="♫&#10;AUDIO&#10;Music"
                android:textColor="#FF91B0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- BOX 6 -->

            <TextView
                android:id="@+id/boxSix"
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#202E34"
                android:gravity="center"
                android:text="＋&#10;MORE&#10;Sources"
                android:textColor="#70DDE8"
                android:textSize="14sp"
                android:textStyle="bold" />

        </GridLayout>

        <!-- IMPORTED MEDIA -->

        <TextView
            android:id="@+id/importedMedia"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="#11161F"
            android:gravity="center"
            android:text="No media selected"
            android:textColor="#55D8FF"
            android:textSize="14sp" />

        <!-- COLOR SECTION -->

        <TextView
            android:id="@+id/colorsTitle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:text="Colors"
            android:textColor="#F1F3F8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">
            <TextView
                android:id="@+id/backgroundBlack"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#000000"
                android:gravity="center"
                android:text="Black"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundWhite"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="White"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundRed"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#FF4D5A"
                android:gravity="center"
                android:text="Red"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundGreen"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#20B77A"
                android:gravity="center"
                android:text="Green"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundBlue"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#3E8BFF"
                android:gravity="center"
                android:text="Blue"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundYellow"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#FFD83D"
                android:gravity="center"
                android:text="Yellow"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />

        </GridLayout>

        <TextView
            android:id="@+id/backgroundSelected"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Selected: Black"
            android:textColor="#55D8FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/backgroundDone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_create_button"
            android:gravity="center"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
