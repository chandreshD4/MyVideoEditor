<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mediaBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Media &amp; Background"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mediaClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Choose media or start with a background"
            android:textColor="#AEB5C2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="18dp"
            android:background="#202A3A"
            android:gravity="center"
            android:text="＋  Import Photo or Video"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mediaDevice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#171D27"
                android:gravity="center"
                android:text="Video"
                android:textColor="#DCE2EC"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/mediaPhotos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#171D27"
                android:gravity="center"
                android:text="Photo"
                android:textColor="#DCE2EC"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/importedMedia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#11161F"
            android:gravity="center"
            android:text="＋  Import photo or video"
            android:textColor="#56D5FF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:text="Background Colors"
            android:textColor="#F1F3F8"
            android:textSize="19sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <TextView
                android:id="@+id/backgroundBlack"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="#000000"
                android:gravity="center"
                android:text="Black"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundWhite"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="White"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundRed"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="#FF4D5A"
                android:gravity="center"
                android:text="Red"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundGreen"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="#20B77A"
                android:gravity="center"
                android:text="Green"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundBlue"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="#3E8BFF"
                android:gravity="center"
                android:text="Blue"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backgroundYellow"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="#FFD83D"
                android:gravity="center"
                android:text="Yellow"
                android:textColor="#171717"
                android:textSize="15sp"
                android:textStyle="bold" />

        </GridLayout>

        <TextView
            android:id="@+id/backgroundSelected"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Selected: Black"
            android:textColor="#55D8FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/backgroundDone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="#39C8F0"
            android:gravity="center"
            android:text="Continue"
            android:textColor="#061018"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
