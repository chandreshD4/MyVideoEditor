<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A0F">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/formatClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:text="New Project"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/importButton"
            android:layout_width="112dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_import_button"
            android:text="⇩  Import"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- PROJECT NAME -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Project name"
                android:textColor="#E5E7ED"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/projectName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_project_name"
                android:hint="Enter project name"
                android:textColor="#FFFFFF"
                android:textColorHint="#777C87"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true" />

            <!-- ASPECT RATIO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aspect ratio"
                android:textColor="#E5E7ED"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <!-- RATIO ROW 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ratio16x9"
                    android:layout_width="78dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_selected"
                    android:text="▶&#10;16:9&#10;YouTube"
                    android:textColor="#FF5963"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ratio9x16"
                    android:layout_width="54dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▶&#10;9:16&#10;Shorts"
                    android:textColor="#B8BDC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ratio1x1"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="◎&#10;1:1&#10;Square"
                    android:textColor="#B8BDC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ratio4x3"
                    android:layout_width="76dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▷&#10;4:3&#10;Classic"
                    android:textColor="#B8BDC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- RATIO ROW 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ratio3x4"
                    android:layout_width="54dp"
                    android:layout_height="78dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▷&#10;3:4&#10;Portrait"
                    android:textColor="#B8BDC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ratio4x5"
                    android:layout_width="58dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="◎&#10;4:5&#10;Instagram"
                    android:textColor="#B8BDC8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ratioCinema"
                    android:layout_width="90dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▬ 2.35:1&#10;Cinema"
                    android:textColor="#B8BDC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/customRatio"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="+&#10;CUSTOM"
                    android:textColor="#B8BDC8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ADVANCED HEADER -->

            <LinearLayout
                android:id="@+id/advancedHeader"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Advanced"
                    android:textColor="#E5E7ED"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/advancedArrow"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌄"
                    android:textColor="#B8BDC8"
                    android:textSize="24sp" />

            </LinearLayout>

            <!-- ADVANCED CONTENT -->

            <LinearLayout
                android:id="@+id/advancedContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Photo display mode"
                    android:textColor="#E5E7ED"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/photoFit"
                        android:layout_width="90dp"
                        android:layout_height="72dp"
                        android:gravity="center"
                        android:text="▧&#10;Fit"
                        android:textColor="#42C9F2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_mode_selected" />

                    <TextView
                        android:id="@+id/photoFill"
                        android:layout_width="90dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:text="▧&#10;Fill"
                        android:textColor="#B8BDC8"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_mode_unselected" />

                    <TextView
                        android:id="@+id/photoAuto"
                        android:layout_width="90dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:text="●&#10;Auto"
                        android:textColor="#B8BDC8"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_mode_unselected" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Default photo duration"
                        android:textColor="#E5E7ED"
                        android:textSize="15sp"
                        android:gravity="center_vertical" />

                    <TextView
                        android:id="@+id/photoDurationValue"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="4.5"
                        android:textColor="#48C8F2"
                        android:textSize="14sp" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/photoDurationSlider"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:max="100"
                    android:progress="35" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Default transition duration"
                        android:textColor="#E5E7ED"
                        android:textSize="15sp"
                        android:gravity="center_vertical" />

                    <TextView
                        android:id="@+id/transitionDurationValue"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1.5"
                        android:textColor="#48C8F2"
                        android:textSize="14sp" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/transitionDurationSlider"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:max="100"
                    android:progress="15" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- CREATE BUTTON -->

    <TextView
        android:id="@+id/createButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:background="@drawable/bg_create_button"
        android:text="Create"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
