<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A0F">

    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/formatClose"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="New Project"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/importButton"
            android:layout_width="125dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_import_button"
            android:text="⇩  Import"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="25dp">


            <!-- PROJECT NAME -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Project name"
                android:textColor="#E5E7ED"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/projectName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_project_name"
                android:hint="Enter project name"
                android:textColor="#FFFFFF"
                android:textColorHint="#777C87"
                android:textSize="16sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true" />


            <!-- ASPECT RATIO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aspect ratio"
                android:textColor="#E5E7ED"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="16dp" />


            <!-- ROW 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 16:9 -->

                <TextView
                    android:id="@+id/ratio16x9"
                    android:layout_width="112dp"
                    android:layout_height="78dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_selected"
                    android:text="▶&#10;16:9&#10;YouTube"
                    android:textColor="#FF5963"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 9:16 -->

                <TextView
                    android:id="@+id/ratio9x16"
                    android:layout_width="66dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="18dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▶&#10;9:16&#10;Shorts"
                    android:textColor="#B8BDC8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 1:1 -->

                <TextView
                    android:id="@+id/ratio1x1"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="18dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="◎&#10;1:1&#10;Square"
                    android:textColor="#B8BDC8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 4:3 -->

                <TextView
                    android:id="@+id/ratio4x3"
                    android:layout_width="100dp"
                    android:layout_height="75dp"
                    android:layout_marginStart="18dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▷&#10;4:3&#10;Classic"
                    android:textColor="#B8BDC8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ROW 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 3:4 -->

                <TextView
                    android:id="@+id/ratio3x4"
                    android:layout_width="72dp"
                    android:layout_height="96dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▷&#10;3:4&#10;Portrait"
                    android:textColor="#B8BDC8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 4:5 -->

                <TextView
                    android:id="@+id/ratio4x5"
                    android:layout_width="76dp"
                    android:layout_height="95dp"
                    android:layout_marginStart="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="◎&#10;4:5&#10;Instagram"
                    android:textColor="#B8BDC8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- CINEMA -->

                <TextView
                    android:id="@+id/ratioCinema"
                    android:layout_width="118dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="▬  2.35:1&#10;Cinema"
                    android:textColor="#B8BDC8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- CUSTOM -->

                <TextView
                    android:id="@+id/customRatio"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ratio_unselected"
                    android:text="+&#10;CUSTOM"
                    android:textColor="#B8BDC8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ADVANCED HEADER -->

            <LinearLayout
                android:id="@+id/advancedHeader"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Advanced"
                    android:textColor="#E5E7ED"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/advancedArrow"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌄"
                    android:textColor="#B8BDC8"
                    android:textSize="25sp" />

            </LinearLayout>


            <!-- ADVANCED CONTENT -->

            <LinearLayout
                android:id="@+id/advancedContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Photo display mode"
                    android:textColor="#E5E7ED"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="12dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/photoFit"
                        android:layout_width="100dp"
                        android:layout_height="82dp"
                        android:gravity="center"
                        android:text="▧&#10;Fit"
                        android:textColor="#42C9F2"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_mode_selected" />

                    <TextView
                        android:id="@+id/photoFill"
                        android:layout_width="100dp"
                        android:layout_height="82dp"
                        android:layout_marginStart="15dp"
                        android:gravity="center"
                        android:text="▧&#10;Fill"
                        android:textColor="#B8BDC8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_mode_unselected" />

                    <TextView
                        android:id="@+id/photoAuto"
                        android:layout_width="100dp"
                        android:layout_height="82dp"
                        android:layout_marginStart="15dp"
                        android:gravity="center"
                        android:text="●&#10;Auto"
                        android:textColor="#B8BDC8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_mode_unselected" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Default photo duration"
                            android:textColor="#E5E7ED"
                            android:textSize="16sp"
                            android:gravity="center_vertical" />

                        <TextView
                            android:id="@+id/photoDurationValue"
                            android:layout_width="50dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="4.5"
                            android:textColor="#48C8F2"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/photoDurationSlider"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:max="100"
                        android:progress="35" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Default transition duration"
                            android:textColor="#E5E7ED"
                            android:textSize="16sp"
                            android:gravity="center_vertical" />

                        <TextView
                            android:id="@+id/transitionDurationValue"
                            android:layout_width="50dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="1.5"
                            android:textColor="#48C8F2"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/transitionDurationSlider"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:max="100"
                        android:progress="15" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- CREATE -->

    <TextView
        android:id="@+id/createButton"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:background="@drawable/bg_create_button"
        android:text="Create"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
